# colcon build output — regenerated by `colcon build`, never committed
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Recordings and mission data. Keep the directory, not its contents: rosbags are
# large and are field data, not source.
data/*
!data/.gitkeep
*.mcap
*.db3
*.bag

# Local calibration results. The placeholder config/camera_info.yaml is tracked; a
# calibration for one specific camera in one specific housing is not portable, so
# keep yours out of the shared history.
**/camera_info_*.yaml
calibration/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
