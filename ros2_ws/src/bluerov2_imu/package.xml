<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerov2_imu</name>
  <version>0.1.0</version>
  <description>
    MAVLink to ROS 2 driver for the inertial sensors of a BlueROV2 Heavy. Reads the
    Navigator flight controller's IMU, magnetometer and barometer through ArduSub and
    republishes them in REP-103 conventions.
  </description>
  <maintainer email="adaca@dtu.dk">Adolfo Damiano Cafaro</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- pymavlink comes from pip (see requirements.txt); rosdep has no key for it. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
