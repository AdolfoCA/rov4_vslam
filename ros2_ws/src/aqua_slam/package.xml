<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aqua_slam</name>
  <version>0.1.0</version>
  <description>
    AQUA-SLAM: tightly-coupled underwater acoustic-visual-inertial SLAM (stereo + DVL + gyro),
    ported from ROS 1 to ROS 2 Humble and configured for the BlueROV2 Heavy.
    Upstream: https://github.com/SenseRoboticsLab/AQUA-SLAM
  </description>
  <maintainer email="adocafaro@gmail.com">Adolfo Damiano Cafaro</maintainer>
  <license>GPL-3.0-only</license>
  <author>Shida Xu</author>
  <author>Kaicheng Zhang</author>
  <author>Sen Wang</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>pcl_conversions</depend>
  <depend>octomap</depend>
  <depend>octomap_msgs</depend>
  <depend>bluerov2_msgs</depend>

  <depend>eigen</depend>
  <!-- OpenCV (incl. contrib ximgproc) and Sophus come from the Dockerfile. -->
  <depend>libpcl-all-dev</depend>
  <depend>boost</depend>
  <depend>fmt</depend>
  <depend>libssl-dev</depend>

  <exec_depend>bluerov2_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
