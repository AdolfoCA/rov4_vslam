<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerov2_tf</name>
  <version>0.1.0</version>
  <description>
    Publishes the BlueROV2's sensor extrinsics on /tf_static from a single validated
    configuration file, in place of several static_transform_publisher processes.
  </description>
  <maintainer email="adaca@dtu.dk">Adolfo Damiano Cafaro</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
