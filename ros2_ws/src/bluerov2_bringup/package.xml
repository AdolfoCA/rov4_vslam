<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerov2_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files, parameters and frame definitions that bring up the BlueROV2 Heavy
    sensor drivers together.
  </description>
  <maintainer email="adaca@dtu.dk">Adolfo Damiano Cafaro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>bluerov2_imu</exec_depend>
  <exec_depend>bluerov2_dvl</exec_depend>
  <exec_depend>bluerov2_camera</exec_depend>
  <exec_depend>bluerov2_tf</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
