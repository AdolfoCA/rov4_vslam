<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerov2_dvl</name>
  <version>0.1.0</version>
  <description>
    ROS 2 driver for a Water Linked DVL-A50 speaking the newline-delimited JSON
    protocol on TCP port 16171. Publishes bottom-track velocity, per-beam detail,
    altitude and the instrument's own dead-reckoning.
  </description>
  <maintainer email="adaca@dtu.dk">Adolfo Damiano Cafaro</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>bluerov2_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
