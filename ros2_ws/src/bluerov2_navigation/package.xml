<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerov2_navigation</name>
  <version>0.1.0</version>
  <description>
    Navigation pieces for autonomous runs at the harbour: the pier calibration that places the
    AQUA-SLAM map in the georeferenced harbour frame (porto) before a mission.
  </description>
  <maintainer email="50945937+andreaalbasini@users.noreply.github.com">Andrea Albasini</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>bluerov2_msgs</exec_depend>
  <exec_depend>aqua_slam</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
